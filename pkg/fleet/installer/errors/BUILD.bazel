load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/dd_go_test:defs.bzl", "dd_go_test")

go_library(
    name = "errors",
    srcs = ["errors.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/fleet/installer/errors",
    visibility = ["//visibility:public"],
)

dd_go_test(
    name = "errors_test",
    srcs = ["errors_test.go"],
    embed = [":errors"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
