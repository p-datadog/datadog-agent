load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/dd_go_test:defs.bzl", "dd_go_test")

go_library(
    name = "fips",
    srcs = [
        "fips.go",
        "fips_disabled.go",
        "fips_goboring.go",
